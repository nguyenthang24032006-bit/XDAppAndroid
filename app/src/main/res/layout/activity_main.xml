<?xml version="1.0" encoding="utf-8"?>
<!-- activity_main.xml -->
<!-- File: res/layout/activity_main.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B2631"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <!-- Khung Card chứa thông tin sinh viên -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#243342">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:contentDescription="@string/avatar_desc"
                    android:src="@drawable/ic_avatar" />

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:ignore="MissingConstraints"
                    tools:text="Nguyen Dang Thang" />

                <TextView
                    android:id="@+id/tvStudentId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#DCE6EB"
                    tools:text="MSSV: 2415053122339 • Lớp: LTDT" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#DCE6EB"
                    tools:text="anv@ute.udn.vn" />

                <!-- ── Bài tập 1: Số điện thoại + nút Gọi điện ── -->
                <TextView
                    android:id="@+id/tvPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#DCE6EB"
                    tools:text="SĐT: 0905 123 456" />

                <TextView
                    android:id="@+id/tvGpaBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#34B469"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="3.8 GPA (Xuất sắc!!)" />

                <EditText
                    android:id="@+id/edtNewGpa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/hint_new_gpa"
                    android:inputType="numberDecimal"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8FA3B0" />

                <Button
                    android:id="@+id/btnUpdateGpa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#34B469"
                    android:text="@string/btn_update_gpa" />

                <!-- ── Bài tập 1: nút Gọi điện (mở app gọi điện qua Intent) ── -->
                <Button
                    android:id="@+id/btnCall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#2E86C1"
                    android:text="@string/btn_call" />

                <!-- ── Bài tập 2: nút Xóa hồ sơ (AlertDialog xác nhận) ── -->
                <Button
                    android:id="@+id/btnDeleteProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#C0392B"
                    android:text="@string/btn_delete_profile" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
